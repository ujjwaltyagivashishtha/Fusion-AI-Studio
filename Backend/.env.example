# Fusion AI Studio - Backend Environment Configuration

# Server Port
PORT=3000

# Node Environment (set to 'production' when deploying)
NODE_ENV=development

# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/fusion-ai-studio

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Redis Cache & Pub/Sub
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Gemini / Google Generative AI API Key
GOOGLE_AI_KEY=your_google_ai_key_here

# Gemini model to use (default: gemini-1.5-flash)
# Supported: gemini-1.5-flash, gemini-1.5-pro, gemini-1.0-pro
GEMINI_MODEL=gemini-1.5-flash

# Allowed Frontend URL for CORS & Socket.IO
FRONTEND_URL=http://localhost:5173
