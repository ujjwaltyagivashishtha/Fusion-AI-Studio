# Fusion AI Studio - Backend Environment Configuration

# Server Port
PORT=3000

# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/fusion-ai-studio

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Redis Cache & Pub/Sub
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Gemini / Google Generative AI API Key
GOOGLE_AI_KEY=your_google_ai_key_here

# Allowed Frontend URL for CORS & Socket.IO
FRONTEND_URL=http://localhost:5173
